# Greenlight — private local configuration. Do not commit this file.
# Enter credentials here rather than in chat.

# General reasoning, teacher, and baseline models.
ANTHROPIC_API_KEY=
# Required when the API key is not scoped to a workspace.
# Pass this as the anthropic-workspace-id request header.
ANTHROPIC_WORKSPACE_ID=
# Optional: leave blank for model selection during implementation.
ANTHROPIC_MODEL=

# Jev and actual fine-tuning/model serving.
TYPESAFE_API_KEY=
VERI_API_KEY=

# Hugging Face: write token and your username/writable organization.
HF_TOKEN=
HF_NAMESPACE=

# One Sentry organization, one project, one DSN.
SENTRY_ORG=greenlight-full
SENTRY_PROJECT=greenlight-full
SENTRY_DSN=
# One personal auth token with:
# org:read, project:read, event:read, project:releases
# Used for telemetry inspection and source-map/release operations.
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://sentry.io/

# Optional backend hosting; blank when using browser CLI login/another host.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# Confirmed GitHub repository.
GREENLIGHT_GITHUB_REPO=ManagementMO/headroom
GREENLIGHT_MAX_OUT_OF_POCKET_USD=20
# This budget field records the constraint; runtime enforcement is not built yet.
